{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vitest/globals"],
    "paths": {
      "@bb/plugin-sdk": ["./types/bb-plugin-sdk.d.ts"]
    },
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": ["server.ts", "src/**/*.ts", "tests/**/*.ts", "types/**/*.d.ts"]
}
