{
  "name": "bb-plugin-telegram-agent",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "bb": ">=0.36",
    "bbPluginSdk": "^0.4.1"
  },
  "bb": {
    "name": "Telegram Agent",
    "description": "Talk to a configurable Codex controller and run reviewed BB implementation jobs from Telegram.",
    "branding": { "icon": "Bot" },
    "server": "./server.ts",
    "skills": ["skills/workflow-kit", "skills/guards", "skills/delivery"]
  },
  "scripts": {
    "build": "npm run skills:verify && bb plugin build",
    "skills:sync": "node scripts/sync-workflow-skills.mjs",
    "skills:verify": "node scripts/verify-skill-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@bb/plugin-sdk": "file:vendor/bb-plugin-sdk-0.4.1.tgz",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "bb-app": "0.36.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0",
    "zod": "^4.3.6"
  }
}
