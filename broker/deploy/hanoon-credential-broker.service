[Unit]
Description=Hanoon Credential Broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hanoon-broker
Group=hanoon-broker
WorkingDirectory=/opt/hanoon-credential-broker/current
ExecStart=/usr/bin/node /opt/hanoon-credential-broker/current/dist/broker/src/main.js --config /etc/hanoon-credential-broker/config.json
StateDirectory=hanoon-credential-broker
RuntimeDirectory=hanoon-credential-broker
ReadWritePaths=/var/lib/hanoon-credential-broker /run/hanoon-credential-broker
LoadCredentialEncrypted=onepassword_service_token:/etc/credstore.encrypted/hanoon-onepassword-token.cred
LoadCredentialEncrypted=broker_data_key:/etc/credstore.encrypted/hanoon-broker-data-key.cred
LoadCredentialEncrypted=broker_audit_key:/etc/credstore.encrypted/hanoon-broker-audit-key.cred
LoadCredentialEncrypted=server_certificate:/etc/credstore.encrypted/hanoon-server-certificate.cred
LoadCredentialEncrypted=server_private_key:/etc/credstore.encrypted/hanoon-server-private-key.cred
LoadCredentialEncrypted=client_ca_certificate:/etc/credstore.encrypted/hanoon-client-ca-certificate.cred
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
MemorySwapMax=0
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Restart=on-failure
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
